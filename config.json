{
  "host": "127.0.0.1",
  "port": 8888,
  "max_workers": 60,
  "cache": {
    "max_entries": 300,
    "default_ttl_seconds": 60.0
  },
  "access_control": {
    "rate_limit_enabled": true,
    "rate_limit_rps": 15.0,
    "rate_limit_burst": 25.0,
    "blocked_domains": [
      "blocked.com",
      "*.blocked.com",
      "malicious-site.test",
      "tracker.analytics.bad",
      "ads.annoying.com",
      "gambling-example.com"
    ],
    "blocked_paths": [
      "/restricted*",
      "/secret-admin*",
      "*.badware",
      "*.malicious"
    ],
    "blocked_clients": [],
    "allowed_clients": []
  },
  "logging": {
    "log_file": "proxy.log",
    "quiet": false
  }
}
